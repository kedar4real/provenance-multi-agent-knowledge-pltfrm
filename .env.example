# Copy to .env and fill in. All providers below have free tiers; no paid key is required.
GEMINI_API_KEY=        # https://aistudio.google.com -> Get API key
GROQ_API_KEY=          # https://console.groq.com -> API Keys
MISTRAL_API_KEY=       # https://console.mistral.ai -> Experiment plan -> API Keys
OPENROUTER_API_KEY=    # https://openrouter.ai -> Keys (optional fallback)
OLLAMA_API_KEY=        # https://ollama.com -> Settings -> Keys (optional, last-resort fallback)
SEC_USER_AGENT=        # "<app name> <contact email>" -- required by SEC EDGAR
